# Select exactly one provider: LM or OLLAMA. LM is the default.
MODEL_PROVIDER=LM

# LM Studio settings
LM_STUDIO_MODEL=local-model
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Ollama settings (used when MODEL_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# MCP transport: STDIO or STREAMABLE_HTTP
MCP_TRANSPORT=STDIO

# Streamable HTTP server settings (ignored by the stdio server)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Streamable HTTP client settings (ignored by the stdio client)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_API_KEY=

# Application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
# Logs are written to stderr so STDIO transport messages remain valid.
LOG_LEVEL=DEBUG
